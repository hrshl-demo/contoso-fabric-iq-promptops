/// [Servicing] A kind of service request the bank can record (card freeze, dispute, ...), with the honest outcome wording and the things that must never be claimed (card actually blocked, reversal done, issuer contacted). Recording an instruction is not executing it. Contoso extension entity: no CDM profile entity, BIAN status unmapped. Star role: dimension; grain: one service request type (curated reference source). Lakehouse: dim_service_request_type <- Curated reference data.
entity ServiceRequestType
	lineageTag: fdff0d42-b77a-5892-a00b-69073d812952
	backingTable: ServiceRequestType
	keyProperty: ServiceTypeId

	/// Service request type identifier such as SR-CARD-FREEZE.
	property ServiceTypeId
		dataType: string
		lineageTag: 5d22d8fa-153d-5234-8f54-a3c4c239421e

		backingConfiguration
			valueColumn: ServiceRequestType.ServiceTypeId

