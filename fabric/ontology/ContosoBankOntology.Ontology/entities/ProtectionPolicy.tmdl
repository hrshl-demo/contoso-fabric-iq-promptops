/// [Holdings] An insurance policy (protection policy) held by a customer (term life, family health, individual health). Sum insured is cover, not cash. New cover is never retroactive and never guaranteed reimbursement. Standards: BIAN 13.0.0 Customer Product and Service Directory (custom); no Microsoft CDM reference. Demo mapping, not certification. Star role: dimension; grain: one insurance policy. Lakehouse: dim_protection_policy <- silver_protection_policy <- insurance.json, policies.json.
entity ProtectionPolicy
	lineageTag: afa774b5-531d-5ebb-82c7-dec3219bf9a3
	backingTable: ProtectionPolicy
	keyProperty: PolicyId

	/// Policy identifier such as policy-term-001.
	property PolicyId
		dataType: string
		lineageTag: 540b5d1b-5856-54ac-bc90-d13cd95b4dfd

		backingConfiguration
			valueColumn: ProtectionPolicy.PolicyId

