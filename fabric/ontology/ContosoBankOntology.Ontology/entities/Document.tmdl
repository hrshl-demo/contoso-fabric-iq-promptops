/// [Servicing] A customer document: salary slip, school fee circular, scam message, card statement, FD renewal notice, loan offer. Documents are evidence only when the customer selected them and consented; FactsText holds the key facts in readable form. Content itself is in Foundry IQ, not here. Standards: BIAN 13.0.0 Document Directory (custom); Microsoft CDM CustomDocument (semantic reference only). Demo mapping, not certification. Star role: dimension; grain: one document. Lakehouse: dim_document <- silver_document <- documents.json.
entity Document
	lineageTag: c3c6d409-43b0-51b0-b4b8-1408431b765e
	backingTable: Document
	keyProperty: DocumentId

	/// Document identifier such as doc-school-fee or DOC-N-PENSION.
	property DocumentId
