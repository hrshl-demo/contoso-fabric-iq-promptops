/// [Catalogue] A bank product: savings, fixed and recurring deposit, sweep, credit and debit card, home loan, health cover. 24 catalogue products carry full terms; products named only by Frontier records (card, floating home loan, education term cover, index fund) are reference stubs with no terms: do not quote their rates or fees. Rupee parameters are whole rupees, rates are percent. Standards: BIAN 13.0.0 Product Directory (custom); no Microsoft CDM reference. Demo mapping, not certification. Star role: dimension; grain: one catalogue product. Lakehouse: dim_product <- silver_product <- products.json, relationship/products.json.
entity Product
	lineageTag: 88492470-b71d-5ef2-968e-d5836f6efebe
	backingTable: Product
	keyProperty: ProductId

	/// Product code such as CB-FD-STANDARD or CB-CARD-CLASSIC.
	property ProductId
		dataType: string
		lineageTag: 1b96e08e-69fc-5f00-92c0-3aee04e5022e

		backingConfiguration
			valueColumn: Product.ProductId

