/// [Money] A posted account or card transaction. Amount is always positive; Direction says debit or credit and SignedAmountInr carries the sign. Frontier covers Apr-Sep 2026 for Rhea; legacy covers three personas. Do not add transactions across ReleaseId. Standards: BIAN 13.0.0 Payment Execution (custom), Position Keeping (custom); no Microsoft CDM reference. Demo mapping, not certification. Star role: fact; grain: one ledger posting. Lakehouse: fact_transaction <- silver_transaction <- transactions.json.
entity Transaction
	lineageTag: 879d6c37-4fb1-5e7b-b2e7-16eedd467dcf
	backingTable: Transaction
	keyProperty: TransactionId

	/// Transaction identifier such as txn-frontier-0001.
	property TransactionId
		dataType: string
		lineageTag: 4008b808-e6b8-5e35-ad88-39ce6d036d7b

		backingConfiguration
			valueColumn: Transaction.TransactionId

	/// Customer the transaction belongs to.
	property CustomerId
		dataType: string
		lineageTag: d232fa9a-977a-5e41-a455-15b15df6c763

		backingConfiguration
			valueColumn: Transaction.CustomerId

