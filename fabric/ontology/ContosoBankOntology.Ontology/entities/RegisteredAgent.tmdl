	property KyaProviderName
		dataType: string
		lineageTag: eb5f493f-551c-5f79-9195-8539d43da8ec

		backingConfiguration
			valueColumn: RegisteredAgent.KyaProviderName

	/// KYA registration id (synthetic).
	property KyaRegistrationId
		dataType: string
		lineageTag: affc442f-fdd9-50e7-81f6-64e45706407e

		backingConfiguration
			valueColumn: RegisteredAgent.KyaRegistrationId

	/// How the agent was verified: synthetic_registry_fixture. Not an external certification.
	property KyaVerificationMethod
		dataType: string
		lineageTag: 895babf2-2dde-57de-a4c7-8b1be04f0486

		backingConfiguration
			valueColumn: RegisteredAgent.KyaVerificationMethod

