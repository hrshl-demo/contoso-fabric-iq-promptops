	property MonthlyLimitInr
		dataType: double
		lineageTag: 3c30bb4d-25f7-5416-8c70-fadd95d89743

		backingConfiguration
			valueColumn: FrontierMandate.MonthlyLimitInr

	/// The source account must still hold at least this after an action. In rupees (INR).
	property MinimumSourceBalanceInr
		dataType: double
