	property ConsentId
		dataType: string
		lineageTag: f472b952-aa45-5458-81d2-725f7aa58e74

		backingConfiguration
			valueColumn: FrontierMandate.ConsentId

	/// Account money may leave.
	property SourceAccountId
		dataType: string
		lineageTag: 90f580c0-ed5f-5212-b5a4-c69f19cf7ad9

		backingConfiguration
			valueColumn: FrontierMandate.SourceAccountId

