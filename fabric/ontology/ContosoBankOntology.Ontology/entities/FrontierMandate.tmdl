		dataType: string
		lineageTag: 830bc18d-8546-5055-9a21-3ae880c5afc4

		backingConfiguration
			valueColumn: FrontierMandate.GoalId

	/// active, paused, revoked or expired. Only active may execute.
	property Status
		dataType: string
		lineageTag: a7140afb-0151-5b51-bcf4-5e42ad2d82af

		backingConfiguration
			valueColumn: FrontierMandate.Status

