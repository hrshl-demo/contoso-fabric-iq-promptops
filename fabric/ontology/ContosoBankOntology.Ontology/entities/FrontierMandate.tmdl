/// [Authority] A mandate: a bounded standing authority for an agent to move surplus cash into a goal (surplus_to_goal) within a per-action cap, a monthly cap and a minimum balance that must remain in the source account. Frontier mandate-surplus-001 has been revoked; a revoked, paused or expired mandate cannot execute. Standards: no verified BIAN mapping (custom semantics); no Microsoft CDM reference. Demo mapping, not certification. Star role: dimension; grain: one mandate. Lakehouse: dim_frontier_mandate <- silver_frontier_mandate <- mandates.json.
entity FrontierMandate
	lineageTag: c98dc08e-54db-5fc0-8a75-f0ae566a6ebf
	backingTable: FrontierMandate
	keyProperty: MandateId

	/// Mandate identifier such as mandate-surplus-001.
	property MandateId
		dataType: string
		lineageTag: ae3a7afa-b004-5f15-a242-37f63d5a25dd

		backingConfiguration
			valueColumn: FrontierMandate.MandateId

	/// Customer who granted the mandate.
	property CustomerId
		dataType: string
		lineageTag: ddb8ff1c-809a-5761-9e0c-83460ccfe424

		backingConfiguration
			valueColumn: FrontierMandate.CustomerId

	/// Registered agent bound to the mandate.
	property AgentId
		dataType: string
		lineageTag: 34575164-48d0-53cc-b208-3a7ee60261da

		backingConfiguration
			valueColumn: FrontierMandate.AgentId

